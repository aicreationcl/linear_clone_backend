# Server
NODE_ENV=development
PORT=3001

# Database
# Obtener de MongoDB Atlas → Connect → Drivers → Node.js
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/linear_clone_dev

# Auth — usar string aleatorio mínimo 32 chars, distinto por entorno
JWT_SECRET=cambiar_por_string_aleatorio_minimo_32_chars_en_produccion
JWT_EXPIRES_IN=7d

# CORS — separar múltiples orígenes con coma, sin espacios
CORS_ALLOWED_ORIGINS=http://localhost:5173
